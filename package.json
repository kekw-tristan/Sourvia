{
  "name": "sourvia",
  "version": "0.1.0",
  "private": true,
  "description": "A small graph-first C++ and HLSL editor",
  "main": "dist/main/main.js",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.main.json && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit",
    "start": "electron .",
    "test": "tsx --test tests/*.test.ts",
    "test:electron": "node scripts/electron-smoke.mjs",
    "test:clangd": "tsx tests/clangd.integration.ts"
  },
  "dependencies": {
    "@xyflow/react": "^12.8.5",
    "monaco-editor": "^0.52.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "electron": "^40.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
